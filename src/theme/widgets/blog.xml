            <!-- ===== Blog1: lógica. La presentación está en parts/blog-*.xml. ===== -->
            <b:includable id='main' var='top'>
              <b:if cond='data:view.isError'>
                <b:include name='errorPage'/>
              <b:elseif cond='data:view.isSingleItem'/>
                <b:loop values='data:posts' var='post'>
                  <b:if cond='data:view.isPost'>
                    <b:include data='post' name='article'/>
                    <b:include data='post' name='postJsonLd'/>
                  <b:else/>
                    <b:include data='post' name='staticPage'/>
                  </b:if>
                </b:loop>
              <b:else/>
                <b:include name='listHeader'/>
                <b:if cond='data:posts.empty'>
                  <b:include name='emptyState'/>
                <b:elseif cond='data:view.isHomepage'/>
                  <b:include name='homeLayout'/>
                <b:else/>
                  <b:include name='listLayout'/>
                </b:if>
                <b:include name='pager'/>
              </b:if>
            </b:includable>

            <!-- Comentarios nativos: la lista y el formulario (iframe) los genera Blogger con sus
                 includables por defecto (threadedComments / comments). No reescribirlos: el JS de
                 respuestas de Blogger depende de su marcado. -->
            <b:includable id='commentPicker' var='post'>
              <b:if cond='data:post.showThreadedComments'>
                <b:include data='post' name='threadedComments'/>
              <b:else/>
                <b:include data='post' name='comments'/>
              </b:if>
            </b:includable>

            <!-- Datos estructurados del artículo: NewsArticle + BreadcrumbList. -->
            <b:includable id='postJsonLd' var='post'>
              <b:with value='{{SECTION_OF:post}}' var='section'>
              <script type='application/ld+json'>{
  "@context": "https://schema.org",
  "@type": "NewsArticle",
  "mainEntityOfPage": { "@type": "WebPage", "@id": "<data:post.url.canonical.jsonEscaped/>" },
  "url": "<data:post.url.canonical.jsonEscaped/>",
  "headline": "<data:post.title.jsonEscaped/>",
  "description": "<data:post.snippets.short.jsonEscaped/>",
<b:if cond='data:post.featuredImage'><b:if cond='data:post.featuredImage.isResizable'>  "image": ["<b:eval expr='resizeImage(data:post.featuredImage, 1200, "16:9")'/>", "<b:eval expr='resizeImage(data:post.featuredImage, 1200, "4:3")'/>", "<b:eval expr='resizeImage(data:post.featuredImage, 1200, "1:1")'/>"],
<b:else/>  "image": ["<data:post.featuredImage.jsonEscaped/>"],
</b:if></b:if>  "datePublished": "<data:post.date.iso8601/>",
  "dateModified": "<b:eval expr='data:post.lastUpdated ? data:post.lastUpdated.iso8601 : data:post.date.iso8601'/>",
  "author": [{ "@type": "Person", "name": "<data:post.author.name.jsonEscaped/>"<b:if cond='data:post.author.profileUrl'>, "url": "<data:post.author.profileUrl.jsonEscaped/>"</b:if> }],
  "publisher": { "@type": "NewsMediaOrganization", "name": "<data:blog.title.jsonEscaped/>", "url": "<data:blog.homepageUrl.jsonEscaped/>" },
<b:if cond='data:section'>  "articleSection": "<data:section.name.jsonEscaped/>",
</b:if><b:if cond='data:post.labels'>
  "keywords": [<b:loop index='li' values='data:post.labels' var='label'><b:if cond='data:li != 0'>, </b:if>"<data:label.name.jsonEscaped/>"</b:loop>],
</b:if>  "isAccessibleForFree": true,
  "inLanguage": "es-ES"
}</script>
              <script type='application/ld+json'>{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Portada", "item": "<data:blog.homepageUrl.jsonEscaped/>" },
<b:if cond='data:section'>    { "@type": "ListItem", "position": 2, "name": "<data:section.name.jsonEscaped/>", "item": "<data:section.url.jsonEscaped/>" },
    { "@type": "ListItem", "position": 3, "name": "<data:post.title.jsonEscaped/>" }
<b:else/>    { "@type": "ListItem", "position": 2, "name": "<data:post.title.jsonEscaped/>" }
</b:if>  ]
}</script>
              </b:with>
            </b:includable>

