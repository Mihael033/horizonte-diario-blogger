{
  "$comment": "Fonte única dos tokens do tema Horizonte. O build gera o :root do preview e as <Variable> do b:skin do Blogger. Editar só aqui.",
  "color": {
    "bg":         { "light": "#FFFFFF", "dark": "#0B1527", "bv": "Fondo de la página" },
    "surface":    { "light": "#F1F4F9", "dark": "#111F37", "bv": "Fondo de módulos (bruma)" },
    "surface-2":  { "light": "#E3E9F3", "dark": "#1A2B4C", "bv": "Fondo de módulos intenso" },
    "ink":        { "light": "#0E1B33", "dark": "#ECF1FA", "bv": "Texto principal y titulares" },
    "ink-soft":   { "light": "#33405A", "dark": "#C3CCDD", "bv": "Texto secundario" },
    "muted":      { "light": "#56627B", "dark": "#9AA6BE", "bv": "Fechas y metadatos" },
    "rule":       { "light": "#D3DBE7", "dark": "#26385C", "bv": "Líneas finas" },
    "horizon":    { "light": "#0E1B33", "dark": "#ECF1FA", "bv": "Línea del horizonte" },
    "accent":     { "light": "#1F45C4", "dark": "#93A9FF", "bv": "Azul cobalto: enlaces y marca" },
    "accent-ink": { "light": "#FFFFFF", "dark": "#0B1527", "bv": "Texto sobre el azul" },
    "sun":        { "light": "#F4B400", "dark": "#F7C948", "bv": "Sol: marca y destacados" },
    "sun-ink":    { "light": "#0E1B33", "dark": "#0B1527", "bv": "Texto sobre el sol" },
    "live":       { "light": "#C8102E", "dark": "#FF6B7D", "bv": "Última hora" },
    "focus":      { "light": "#1F45C4", "dark": "#F7C948", "bv": "Anillo de foco" },
    "footer":     { "light": "#0E1B33", "dark": "#070F1D", "bv": "Fondo del pie" },
    "footer-ink": { "light": "#DCE3EF", "dark": "#C3CCDD", "bv": "Texto del pie" }
  },
  "section": {
    "$comment": "Color por sección (etiqueta). La clave es el slug; label es el nombre exacto de la etiqueta en Blogger.",
    "actualidad": { "label": "Actualidad", "light": "#1F45C4", "dark": "#93A9FF" },
    "economia":   { "label": "Economía",   "light": "#0A7556", "dark": "#4FD1A5" },
    "cultura":    { "label": "Cultura",    "light": "#8B2C7F", "dark": "#E890D9" },
    "tecnologia": { "label": "Tecnología", "light": "#5B3FD1", "dark": "#B6A6FF" },
    "deportes":   { "label": "Deportes",   "light": "#B03E0A", "dark": "#FF9C66" },
    "opinion":    { "label": "Opinión",    "light": "#835600", "dark": "#EBC15F" }
  },
  "font": {
    "serif": { "value": "\"Newsreader\", \"Newsreader Fallback\", Georgia, \"Times New Roman\", serif", "bv": "Tipografía de titulares" },
    "sans":  { "value": "\"Schibsted Grotesk\", \"Schibsted Grotesk Fallback\", system-ui, -apple-system, \"Segoe UI\", Roboto, Arial, sans-serif", "bv": "Tipografía de texto" }
  },
  "type": {
    "$comment": "Escala fluida (Utopia): base y razón en 360px y en 1280px.",
    "minViewport": 360,
    "maxViewport": 1280,
    "minBase": 17,
    "maxBase": 19,
    "minRatio": 1.2,
    "maxRatio": 1.3,
    "steps": [-2, -1, 0, 1, 2, 3, 4, 5, 6]
  },
  "space": {
    "$comment": "Multiplicadores de la base fluida.",
    "3xs": 0.25, "2xs": 0.5, "xs": 0.75, "s": 1, "m": 1.5, "l": 2, "xl": 3, "2xl": 4, "3xl": 6
  },
  "layout": {
    "container": "84rem",
    "measure": "68ch",
    "gutter": "clamp(1rem, 0.6rem + 1.8vw, 2rem)",
    "radius-s": "4px",
    "radius-m": "10px",
    "radius-pill": "999px",
    "header-h": "3.5rem"
  },
  "motion": {
    "ease-out": "cubic-bezier(0.22, 1, 0.36, 1)",
    "ease-in-out": "cubic-bezier(0.65, 0, 0.35, 1)",
    "dur-1": "140ms",
    "dur-2": "260ms",
    "dur-3": "520ms",
    "dur-4": "1100ms"
  }
}
